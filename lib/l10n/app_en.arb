	"tajMahalPullQuote1Top": "Not just a Monument,",
	"tajMahalPullQuote1Bottom": "but a Symbol of Love.",
	"tajMahalPullQuote1Author": "Suman Pokhrel",
	"tajMahalPullQuote2": "The Taj Mahal rises above the banks of the river like a solitary tear suspended on the cheek of time.",
	"tajMahalPullQuote2Author": "Rabindranath Tagore",
	"tajMahalCallout1": "The Taj Mahal is distinguished as the finest example of Mughal architecture, a blend of Indian, Persian, and Islamic styles.",
